<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Package Metadata adhering to Microsoft Package Authoring Best Practices
       (https://learn.microsoft.com/nuget/create-packages/package-authoring-best-practices) -->
  <PropertyGroup>
    <PackageId>PayPal.PartnerGateway.AspNetCore</PackageId>
    <Version>1.0.2</Version>
    <Authors>Jose Modi</Authors>
    <Company>Jose Modi</Company>
    <Copyright>Copyright (c) 2026 Jose Modi</Copyright>
    <Title>PayPal Partner APIs ASP.NET Core Integration</Title>
    <Description>ASP.NET Core integration for PayPal.PartnerGateway: AddPayPalPartnerGateway() dependency-injection registration (appsettings.json or fluent config), and MapPayPalPartnerWebhook() for Minimal API webhook endpoints with automatic PayPal signature verification. MVC controller helpers included.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JoseModi97/paypal-partner-gateway-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JoseModi97/paypal-partner-gateway-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>paypal;paypal-api;paypal-webhooks;paypal-checkout;aspnetcore;aspnetcore-webapi;minimalapi;dependency-injection;webhook-verification;marketplace-payments;dotnet;csharp;sdk</PackageTags>
    <PackageReleaseNotes>1.0.2: Picks up PayPal.PartnerGateway 1.0.2, which fixes a real bug where bodyless POST/PUT/PATCH calls (order capture/authorize, refunds, etc.) were rejected by PayPal with 415 UNSUPPORTED_MEDIA_TYPE. No changes in this package's own code. 1.0.1: Added net9.0 as an explicit target framework alongside net8.0/net10.0 for broader compatibility. 1.0.0: Initial release - AddPayPalPartnerGateway() DI extensions and MapPayPalPartnerWebhook() signature-verified Minimal API webhook mapping.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PayPal.PartnerGateway\PayPal.PartnerGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

</Project>
