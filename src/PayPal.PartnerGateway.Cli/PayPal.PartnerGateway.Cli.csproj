<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>paypal-partner</ToolCommandName>
    <PackageId>dotnet-paypal-partner-gateway</PackageId>
    <Version>1.2.4</Version>
    <Authors>Jose Modi</Authors>
    <Company>Jose Modi</Company>
    <Copyright>Copyright (c) 2026 Jose Modi</Copyright>
    <Title>PayPal Partner Gateway Setup CLI</Title>
    <Description>Global .NET tool that sets up PayPal.PartnerGateway in your project automatically: detects whether you're in an ASP.NET Core app, Worker Service, console app, or class library and installs/configures the right package(s) for it - no --framework flag needed. Also includes 'order create/get/capture' commands to exercise the real Orders API straight from the terminal.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JoseModi97/paypal-partner-gateway-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JoseModi97/paypal-partner-gateway-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>paypal;paypal-api;dotnet-tool;cli;scaffolding;aspnetcore;dotnet;csharp</PackageTags>
    <PackageReleaseNotes>1.2.4: README fixes - the order return_url/cancel_url redirect gap and CLI documentation alignment; also clarified that the CLI's own order-testing flow has no return_url by design (no running web app to redirect to). No code changes. 1.2.3: Realigned the package version with the repo's git tag numbering (and with the other two packages, which now share the same version). No code changes. 1.1.1: Expanded the README's Sandbox payment walkthrough for the 'order' command. No code changes. 1.1.0: Added 'order create/get/capture' commands - create, fetch, and capture a real Order directly from the terminal, resolving credentials from flags, PAYPAL_* environment variables, or an appsettings.json 'init' already wrote. 1.0.1: Fixed the #:package directive version used when setting up a file-based app - it was pinned to 1.0.0, now matches the current PayPal.PartnerGateway release (1.0.1). 1.0.0: Initial release - 'init' and 'detect' commands with automatic project-framework detection.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PayPal.PartnerGateway\PayPal.PartnerGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

</Project>
