<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package Metadata adhering to Microsoft Package Authoring Best Practices
       (https://learn.microsoft.com/nuget/create-packages/package-authoring-best-practices) -->
  <PropertyGroup>
    <PackageId>PayPal.PartnerGateway</PackageId>
    <Version>1.2.4</Version>
    <Authors>Jose Modi</Authors>
    <Company>Jose Modi</Company>
    <Copyright>Copyright (c) 2026 Jose Modi</Copyright>
    <Title>PayPal Partner APIs Client for .NET</Title>
    <Description>Idiomatic .NET client for PayPal's Partner APIs: seller onboarding (Partner Referrals), Checkout Orders (create/capture/authorize), Captures/Authorizations/Refunds, Webhooks with signature verification, Vault payment tokens, Apple Pay domains, and Shipment Tracking. Handles OAuth2 client-credentials token caching and refresh automatically - no manual HTTP or token plumbing required.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JoseModi97/paypal-partner-gateway-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JoseModi97/paypal-partner-gateway-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>paypal;paypal-api;paypal-checkout;paypal-partner;partner-referral;marketplace-payments;split-payments;checkout;orders;payments;refunds;webhooks;webhook-verification;vault;oauth2;onboarding;dotnet;csharp;sdk</PackageTags>
    <PackageReleaseNotes>1.2.4: README fixes - the "order create/get/capture" CLI flow is now called out outside the ASP.NET Core section, added an "Updating" guide, and the Quickstart order-creation example now sets application_context.return_url/cancel_url so PayPal's approval page actually redirects the buyer back instead of leaving them on PayPal's own page with no confirmation. No library code changes. 1.2.3: Realigned the package version with the repo's git tag numbering (previously the git tags had drifted ahead of the published NuGet version) - no code changes. 1.0.3: Expanded the README's Sandbox payment walkthrough (the create/approve/capture flow, and using a Sandbox buyer account to approve an order). No code changes. 1.0.2: Fixed a real bug found testing against live Sandbox - bodyless POST/PUT/PATCH calls (Orders.CaptureAsync, Orders.AuthorizeAsync, Payments.RefundCaptureAsync, Payments.CaptureAuthorizationAsync, Webhooks.ResendEventNotificationAsync with no overrides) were rejected by PayPal with 415 UNSUPPORTED_MEDIA_TYPE because no Content-Type header was sent; the gateway now attaches an empty JSON body with Content-Type: application/json whenever the caller doesn't supply one for a write method. 1.0.1: Added net9.0 as an explicit target framework alongside netstandard2.0/net8.0/net10.0 for broader compatibility. Added a PartnerId fallback on Partner Referral calls. 1.0.0: Initial release - Partner Referrals, Orders/Checkout, Payments, Webhooks with signature verification, Vault, Apple Pay, Shipment Tracking, and Managed Accounts (limited release), plus automatic OAuth2 token caching.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

</Project>
